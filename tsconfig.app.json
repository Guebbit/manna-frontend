{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": ["api", "src/env.d.ts", "src/**/*", "src/**/*.vue"],
    "exclude": ["src/**/__tests__/*"],
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "ES2023", "DOM", "DOM.Iterable"],
        "strict": true,
        "composite": true,
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@types": ["./src/types"],
            "@api": ["./api"],
            "@api/*": ["./api/*"]
        }
    }
}
